{
  "version": "skin-v1.0",
  "input": {
    "name": "image",
    "shape": [
      1,
      3,
      224,
      224
    ],
    "range": "0..1 RGB",
    "resize": "stretch to 224x224, bilinear"
  },
  "output": {
    "name": "probs",
    "classes": [
      "abrasion",
      "bruise",
      "burn",
      "laceration",
      "normal"
    ],
    "calibrated": true
  },
  "unsure_threshold": 0.6,
  "temperature_baked_in": true
}